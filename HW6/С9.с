#include <stdio.h>

long long factorial(int n) {
    long long result = 1;
    for (int i = 1; i <= n; i++) {
        result *= i;
    }
    return result;
}
int main() {
    int n;  
    if (scanf("%d", &n) == 1) {
        if (n >= 0 && n <= 20) {
            printf("%lld\n", factorial(n));
        }
    }
    return 0;
}
